# index.html se revalida en cada visita para que las actualizaciones se vean al
# momento. Los assets llevan hash en el nombre: pueden cachearse un año.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(json|geojson)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
